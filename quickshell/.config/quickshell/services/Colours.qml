pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick

// The Material 3 palette generated from the current wallpaper by matugen.
//
// `~/.cache/quickshell/colors.json` is written by the matugen template in
// matugen/.config/matugen and regenerated by services/Wallpapers.qml whenever
// the wallpaper changes. Everything here falls back to the hand-picked colours
// in Theme.qml, so the shell still looks right when matugen is not installed
// or has not run yet.
Singleton {
    id: root

    readonly property string cacheDir: Quickshell.env("HOME") + "/.cache/quickshell"
    readonly property string file: root.cacheDir + "/colors.json"

    // Role name -> "#rrggbb". Empty until a palette has been loaded.
    property var roles: ({})

    // True once a generated palette is in use.
    readonly property bool active: Object.keys(root.roles).length > 0

    // Look up a role, falling back to the colour the shell used before it had
    // a colour engine.
    function role(name: string, fallback: color): color {
        const value = root.roles[name];
        return value === undefined ? fallback : value;
    }

    // Re-read the palette. Called by Wallpapers.qml after matugen runs.
    function refresh(): void {
        reader.running = false;
        reader.running = true;
    }

    Process {
        id: reader
        command: ["cat", root.file]
        running: true

        // Missing file is the normal state before the first wallpaper change.
        stderr: StdioCollector {}

        stdout: StdioCollector {
            onStreamFinished: root.roles = root.parse(text)
        }
    }

    // Pick up palettes written by a manual `matugen image ...` run too.
    FileView {
        path: root.file
        watchChanges: true
        printErrors: false
        onFileChanged: root.refresh()
    }

    function parse(text: string): var {
        try {
            const parsed = JSON.parse(text);
            return parsed && typeof parsed === "object" ? parsed : ({});
        } catch (e) {
            return ({});
        }
    }
}
